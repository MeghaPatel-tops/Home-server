# HomeServe Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with local credentials

# Application Settings
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="HomeServe API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security Secrets (Must be changed in production)
SECRET_KEY=change_this_to_a_secure_random_secret_key_at_least_32_characters_long
OTP_SECRET_KEY=change_this_to_a_secure_otp_secret_key_for_hmac_hashing

# MySQL 8.0 Database Configuration
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=homeserve_db

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
