NODE_ENV=development
PORT=8000
APP_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:8000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/homeserve

# JWT
JWT_ACCESS_SECRET=homeserve_jwt_access_secret_super_secure_key_12345
JWT_REFRESH_SECRET=homeserve_jwt_refresh_secret_super_secure_key_67890
ACCESS_TOKEN_EXPIRE=15m
REFRESH_TOKEN_EXPIRE_DAYS=7

# OTP
OTP_HMAC_SECRET=homeserve_otp_hmac_secret_key_abcdef_98765
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=3
OTP_LOCKOUT_MINUTES=15

# Razorpay Test Mode
RAZORPAY_KEY_ID=rzp_test_exampleKey123456
RAZORPAY_KEY_SECRET=rzp_secret_exampleSecret123456
RAZORPAY_WEBHOOK_SECRET=webhook_secret_example123456

# Private Storage (Local fallback for dev)
STORAGE_BUCKET_NAME=homeserve-private
STORAGE_REGION=ap-south-1

# Platform Financials
DEFAULT_PLATFORM_COMMISSION_PERCENT=15
GST_PERCENT=18
MINIMUM_PAYOUT_PAISE=50000
PROVIDER_ACCEPTANCE_SLA_MINUTES=15
