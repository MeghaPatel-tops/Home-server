# HomeServe - Root Git Ignore File

# Environment & Secrets Files (Never commit credentials)
.env
.env.local
.env.*.local
*.env

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Type Checking
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend Build Outputs
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
.eslintcache
*.tsbuildinfo

# Logs & Temporary Files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Uploads & Media (Development only)
backend/uploads/*
!backend/uploads/.gitkeep
!backend/uploads/kyc/.gitkeep
!backend/uploads/proofs/.gitkeep

# IDE & OS Artifacts
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
